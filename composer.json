{
  "name": "derstephan/nextcloud-saml-provider",
  "description": "SAML 2.0 Identity Provider for Nextcloud",
  "type": "nextcloud-app",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "10.5.0"
  },
  "autoload": {
    "psr-4": {
      "OCA\\SAMLProvider\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\SAMLProvider\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:coverage": "phpunit --configuration phpunit.xml.dist --coverage-clover build/coverage/clover.xml --coverage-text && php tests/check-coverage.php build/coverage/clover.xml 80"
  }
}
